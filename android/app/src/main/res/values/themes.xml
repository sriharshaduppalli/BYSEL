<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ draws edge-to-edge by default. Do not set statusBarColor /
         navigationBarColor — those map to deprecated Window APIs. Contrast is
         applied in MainActivity via enableEdgeToEdge + WindowInsetsController. -->
    <style name="Theme.BYSEL" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.BYSEL.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.BYSEL</item>
    </style>
</resources>
